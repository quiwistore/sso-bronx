---
const path = Astro.url.pathname;
const isActive = (prefix) => path === prefix || path.startsWith(prefix);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Social Security Bronx home">
      <span class="logo-mark">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="2" y="2" width="24" height="24" rx="6" fill="#1e5acc" stroke="#0e1116" stroke-width="2"/>
          <path d="M9 11 L13 15 L19 9" stroke="#fdd84d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="logo-text">Social Security<strong>Bronx</strong></span>
    </a>

    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" aria-label="Main navigation">
      <ul>
        <li><a href="/social-security-office-bronx/" class={isActive('/social-security-office-bronx') ? 'active' : ''}>SSA Office</a></li>
        <li><a href="/apply-for-social-security-card-bronx/" class={isActive('/apply-for-social-security-card-bronx') ? 'active' : ''}>Card</a></li>
        <li><a href="/apply-for-disability-benefits-bronx/" class={isActive('/apply-for-disability-benefits-bronx') ? 'active' : ''}>Disability</a></li>
        <li><a href="/apply-for-social-security-retirement-bronx/" class={isActive('/apply-for-social-security-retirement-bronx') ? 'active' : ''}>Retirement</a></li>
        <li><a href="/retirement-age-calculator/" class={isActive('/retirement-age-calculator') ? 'active' : ''}>Calculator</a></li>
      </ul>
      <a href="/social-security-office-bronx/" class="btn btn-primary nav-btn">Find office</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header { background: var(--color-bg); border-bottom: 2.5px solid var(--color-ink); position: sticky; top: 0; z-index: 50; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-3); padding-bottom: var(--space-3); gap: var(--space-4); }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-text { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; color: var(--color-ink); letter-spacing: -0.02em; }
  .logo-text strong { font-weight: 700; color: var(--color-primary); margin-left: 4px; }
  .main-nav { display: flex; align-items: center; gap: var(--space-5); }
  .main-nav ul { display: flex; gap: var(--space-5); list-style: none; padding: 0; margin: 0; }
  .main-nav li { margin: 0; }
  .main-nav a { font-family: var(--font-display); font-weight: 600; font-size: 0.94rem; color: var(--color-ink); text-decoration: none; }
  .main-nav a:hover, .main-nav a.active { color: var(--color-primary); }
  .nav-btn { padding: 10px 20px; font-size: 0.88rem; }
  .menu-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; }
  .menu-toggle span { width: 24px; height: 2.5px; background: var(--color-ink); border-radius: 2px; }
  @media (max-width: 920px) {
    .menu-toggle { display: flex; }
    .main-nav { position: absolute; top: 100%; left: 0; right: 0; background: var(--color-bg); border-bottom: 2.5px solid var(--color-ink); flex-direction: column; align-items: stretch; gap: var(--space-3); padding: var(--space-4) var(--space-5); display: none; }
    .main-nav.open { display: flex; }
    .main-nav ul { flex-direction: column; gap: var(--space-3); }
    .nav-btn { text-align: center; }
  }
</style>
