---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <span class="logo-text"><strong>Social Security</strong> Bronx</span>
        <p>An independent guide for residents of Bronx, New York, on Social Security services, card applications, disability benefits and the local SSA office.</p>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="/apply-for-social-security-card-bronx/">Apply for SSN card</a></li>
          <li><a href="/replace-social-security-card-bronx/">Replace lost card</a></li>
          <li><a href="/apply-for-disability-benefits-bronx/">Disability benefits</a></li>
          <li><a href="/apply-for-medicare-bronx/">Medicare enrollment</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Office info</h4>
        <ul>
          <li><a href="/social-security-office-bronx/">SSA office in the Bronx</a></li>
          <li><a href="/social-security-office-hours-bronx/">Office hours</a></li>
          <li><a href="/social-security-office-appointment-bronx/">Book an appointment</a></li>
          <li><a href="/retirement-age-calculator/">Retirement age calculator</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>About</h4>
        <ul>
          <li><a href="/about/">About this site</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-disclaimer">
      <p><strong>Disclaimer:</strong> Social Security Bronx is an independent informational website. We are not affiliated with, endorsed by or operated by the U.S. Social Security Administration (SSA) or any other government agency. For official information, services and transactions, always visit <a href="https://www.ssa.gov">ssa.gov</a>.</p>
    </div>
    <div class="footer-bottom">
      &copy; {year} Social Security Bronx. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-ink); color: rgba(255,255,255,0.85); padding: var(--space-8) 0 var(--space-5); margin-top: var(--space-9); }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: var(--space-6); margin-bottom: var(--space-6); }
  .footer-brand p { font-size: 0.92rem; color: rgba(255,255,255,0.65); max-width: 320px; margin-top: var(--space-3); }
  .footer-col h4 { color: var(--color-yellow); font-size: 0.95rem; margin-bottom: var(--space-3); }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: var(--space-2); }
  .footer-col a { color: rgba(255,255,255,0.75); text-decoration: none; font-size: 0.9rem; }
  .footer-col a:hover { color: var(--color-accent); }
  .footer-col .logo-text { color: #fff; font-size: 1.3rem; }
  .footer-col .logo-text strong { color: var(--color-accent); }
  .footer-disclaimer { background: rgba(255,255,255,0.06); border-left: 4px solid var(--color-accent); padding: var(--space-4) var(--space-5); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; margin-bottom: var(--space-5); }
  .footer-disclaimer p { font-size: 0.85rem; color: rgba(255,255,255,0.8); margin: 0; line-height: 1.6; }
  .footer-disclaimer a { color: var(--color-yellow); }
  .footer-bottom { font-size: 0.82rem; color: rgba(255,255,255,0.5); padding-top: var(--space-4); border-top: 1px solid rgba(255,255,255,0.1); }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  }
  @media (max-width: 500px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
