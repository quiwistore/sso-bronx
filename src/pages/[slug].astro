---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { allPages, getPage, silos, site } from '../data/datos.js';

export function getStaticPaths() {
  return allPages.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const page = getPage(slug);
const sections = page.sections || [];
const siloLabel = { services: 'Services', office: 'Office info', learn: 'Learn' }[page.silo];

// Helper: inferir icono Font Awesome a partir del texto del step
function iconForStep(q) {
  const t = (q || '').toLowerCase();
  if (/online|website|web|laptop|computer/.test(t)) return 'fa-laptop';
  if (/phone|call|800|by phone/.test(t)) return 'fa-phone';
  if (/in person|visit|office|walk[\s-]?in|appointment/.test(t)) return 'fa-building-columns';
  if (/form|complete|fill|application|ss-?5/.test(t)) return 'fa-file-lines';
  if (/document|original|gather|bring|certified/.test(t)) return 'fa-folder-open';
  if (/interview|representative|meeting/.test(t)) return 'fa-user-tie';
  if (/mail|receive|arrives|by mail/.test(t)) return 'fa-envelope';
  if (/wait|process|time|days|weeks/.test(t)) return 'fa-hourglass-half';
  if (/early|hour|monday|tuesday|wednesday|thursday|friday/.test(t)) return 'fa-clock';
  if (/citizen|immigration|visa|status/.test(t)) return 'fa-passport';
  if (/medical|doctor|disability|health/.test(t)) return 'fa-stethoscope';
  if (/money|cost|fee|payment|free/.test(t)) return 'fa-money-bill';
  if (/retire|age|year|65|66|67|70/.test(t)) return 'fa-cake-candles';
  if (/medicare|insurance/.test(t)) return 'fa-shield-halved';
  return 'fa-circle-check';
}

// FAQ extra de las secciones
const extraFaqs = sections.filter(s => s.type === 'faq_extra').flatMap(s => s.items);

const schema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": extraFaqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const relatedSame = (silos[page.silo]?.items || []).filter(p => p.slug !== slug).slice(0, 5);
---
<Base title={page.title} description={page.meta} schema={schema}>
  <div class="container article">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: page.h1 }]} />

    <header class="art-header">
      <span class="eyebrow">{siloLabel}</span>
      <h1>{page.h1}</h1>
      <p class="lead" set:html={page.intro}></p>
    </header>

    <div class="art-grid">
      <div class="art-main">
        {sections.map(sec => (
          <>
            {sec.type === 'quick_answer' && (
              <div class="quick-answer">
                <span class="qa-tag">{sec.heading}</span>
                <p set:html={sec.body}></p>
              </div>
            )}

            {sec.type === 'quick_answer' && page.embed_src && (
              <div class="office-map">
                <iframe
                  src={page.embed_src}
                  width="100%"
                  height="380"
                  style="border:0;"
                  allowfullscreen
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Map of ${page.h1}`}
                ></iframe>
                <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(page.h1)}`} class="map-link">Open in Google Maps</a>
              </div>
            )}

                        {sec.type === 'call_cta' && (
              <section class="call-cta">
                <div class="call-cta-inner">
                  <span class="call-cta-tag">{sec.heading}</span>
                  <a href={`tel:${sec.phone_tel}`} class="call-cta-phone">
                    <i class="fa-solid fa-phone"></i>
                    <span>{sec.phone}</span>
                  </a>
                  <p class="call-cta-sub">{sec.subtext}</p>
                  <p class="call-cta-tty">TTY: <a href={`tel:${sec.tty_tel}`}>{sec.tty}</a></p>
                  <a href="https://www.ssa.gov/agency/contact/" class="call-cta-alt">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    Or visit SSA.gov for online services
                  </a>
                </div>
              </section>
            )}

            {sec.type === 'map' && (
              <section class="map-block">
                <h2>{sec.heading}</h2>
                <div class="map-wrap">
                  <iframe
                    src={sec.embed_src || `https://maps.google.com/maps?q=${encodeURIComponent(sec.address)}&output=embed`}
                    width="100%" height="380" style="border:0"
                    allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                    title={`Map of ${sec.address}`}>
                  </iframe>
                </div>
                <div class="map-meta">
                  <div class="map-addr">
                    <i class="fa-solid fa-location-dot"></i>
                    <span>{sec.address}</span>
                  </div>
                  <a href={sec.directions_url} class="btn btn-primary">
                    <i class="fa-solid fa-diamond-turn-right"></i>
                    Get directions
                  </a>
                </div>
              </section>
            )}

            {sec.type === 'section' && (
              <section class="rich">
                <h2>{sec.heading}</h2>
                {sec.body.map(par => <p set:html={par}></p>)}
              </section>
            )}

            {sec.type === 'checklist' && (
              <section class="rich">
                <h2>{sec.heading}</h2>
                <ul class="check-list">{sec.items.map(it => <li set:html={it}></li>)}</ul>
              </section>
            )}

            {sec.type === 'troubleshoot' && (
              <section class="rich">
                <h2>{sec.heading}</h2>
                <div class="stepper">
                  {sec.items.map((it, idx) => {
                    const colorClass = ['step-blue','step-orange','step-yellow','step-cream'][idx % 4];
                    return (
                      <div class={`step-card ${colorClass}`}>
                        <div class="step-head">
                          <span class="step-num">{String(idx + 1).padStart(2, '0')}</span>
                          <i class={`fa-solid ${iconForStep(it.q)} step-icon`}></i>
                        </div>
                        <h4>{it.q}</h4>
                        <p set:html={it.a}></p>
                      </div>
                    );
                  })}
                </div>
              </section>
            )}

            {sec.type === 'tool_link' && (
              <div class="tool-link-box">
                <h3>{sec.heading}</h3>
                <p>{sec.body}</p>
                <a href={sec.url} class="btn btn-primary">{sec.label}</a>
              </div>
            )}
          </>
        ))}

        <section class="cta-box">
          <h2>Need to visit the SSA office?</h2>
          <p>Get the address, hours, and how to book an appointment to avoid the wait.</p>
          <div class="cta-actions">
            <a href="/social-security-office-bronx/" class="btn btn-primary">Office info</a>
            <a href="https://www.ssa.gov/agency/contact/" class="btn btn-ghost">Book on SSA.gov</a>
          </div>
        </section>

        {extraFaqs.length > 0 && (
          <section class="faq">
            <h2>Frequently asked questions</h2>
            {extraFaqs.map(f => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p set:html={f.a}></p>
              </details>
            ))}
          </section>
        )}
      </div>

      <aside class="art-side">
        <div class="side-box">
          <h3>{siloLabel}</h3>
          <ul class="side-links">{relatedSame.map(p => <li><a href={`/${p.slug}/`}>{p.h1}</a></li>)}</ul>
        </div>
        <div class="side-box side-cta">
          <p class="side-cta-label">Need to apply?</p>
          <a href="/apply-for-social-security-card-bronx/" class="btn btn-primary btn-block">Apply for SSN card</a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .article { padding-top: var(--space-6); padding-bottom: var(--space-8); }
  .art-header { max-width: 820px; margin-bottom: var(--space-7); }
  .lead { font-size: 1.2rem; color: var(--color-text-muted); line-height: 1.6; margin-top: var(--space-3); }
  .art-grid { display: grid; grid-template-columns: 1fr 300px; gap: var(--space-7); align-items: start; }
  .art-main { min-width: 0; }


  .office-map { margin-bottom: var(--space-6); border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-hard-sm); background: var(--color-bg-alt); }
  .office-map iframe { display: block; width: 100%; height: 380px; border: 0; }
  .map-link { display: block; text-align: center; padding: var(--space-3); background: var(--color-ink); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; text-decoration: none; border-top: 2.5px solid var(--color-ink); transition: background 0.15s; }
  .map-link:hover { background: var(--color-primary); color: #fff; }
  .quick-answer { background: var(--color-yellow); border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); padding: var(--space-5); margin-bottom: var(--space-6); box-shadow: var(--shadow-hard-sm); }
  .qa-tag { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: var(--space-2); }
  .quick-answer p { margin: 0; font-size: 1.08rem; line-height: 1.7; font-weight: 500; }

  /* MAP BLOCK */
  .map-block { margin-bottom: var(--space-7); }
  .map-block h2 { margin-bottom: var(--space-4); }
  .map-wrap { border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-hard); background: var(--color-bg-alt); }
  .map-wrap iframe { display: block; }
  .map-meta { margin-top: var(--space-4); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); padding: var(--space-4); background: var(--color-bg-alt); border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); }
  .map-addr { display: flex; align-items: center; gap: var(--space-3); font-family: var(--font-display); font-weight: 600; font-size: 1rem; }
  .map-addr i { color: var(--color-primary); font-size: 1.3rem; }

  .rich { margin-bottom: var(--space-7); }
  .rich h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-bottom: var(--space-4); }
  .rich p { font-size: 1.05rem; line-height: 1.8; margin-bottom: var(--space-4); }

  .check-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .check-list li { position: relative; padding: var(--space-3) var(--space-4) var(--space-3) 46px; background: var(--color-surface); border: 2.5px solid var(--color-ink); border-radius: var(--radius-sm); line-height: 1.6; box-shadow: var(--shadow-hard-sm); }
  .check-list li::before { content: ''; position: absolute; left: 18px; top: 50%; width: 8px; height: 14px; border: solid var(--color-primary); border-width: 0 3.5px 3.5px 0; transform: translateY(-65%) rotate(45deg); }

  /* STEPPER VISUAL */
  .stepper { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); margin-top: var(--space-4); }
  .step-card { padding: var(--space-5); border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); box-shadow: var(--shadow-hard-sm); transition: transform 0.12s ease, box-shadow 0.12s ease; }
  .step-card:hover { transform: translate(-3px,-3px); box-shadow: var(--shadow-hard); }
  .step-blue   { background: var(--color-primary-light); }
  .step-orange { background: var(--color-accent); }
  .step-yellow { background: var(--color-yellow); }
  .step-cream  { background: var(--color-bg); }
  .step-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); padding-bottom: var(--space-3); border-bottom: 2px solid var(--color-ink); }
  .step-num { font-family: var(--font-display); font-weight: 700; font-size: 2.4rem; line-height: 1; color: var(--color-ink); letter-spacing: -0.04em; }
  .step-icon { font-size: 1.6rem; color: var(--color-ink); }
  .step-card h4 { font-size: 1.1rem; margin-bottom: var(--space-2); line-height: 1.3; }
  .step-card p { font-size: 0.95rem; line-height: 1.65; color: var(--color-text); margin: 0; }

  .tool-link-box { background: var(--color-accent); border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); padding: var(--space-5); margin-bottom: var(--space-6); box-shadow: var(--shadow-hard-sm); }
  .tool-link-box h3 { margin-bottom: var(--space-2); }
  .tool-link-box p { margin-bottom: var(--space-4); }

  .cta-box { background: var(--color-ink); color: #fff; border-radius: var(--radius-lg); padding: var(--space-6); margin-bottom: var(--space-6); border: 2.5px solid var(--color-ink); }
  .cta-box h2 { color: #fff; font-size: 1.6rem; margin-bottom: var(--space-2); }
  .cta-box p { opacity: 0.85; margin-bottom: var(--space-4); }
  .cta-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .cta-box .btn-ghost { color: #fff; border-color: #fff; }
  .cta-box .btn-ghost:hover { background: #fff; color: var(--color-ink); }

  .faq h2 { font-size: 1.6rem; margin-bottom: var(--space-4); }
  .faq-item { border: 2.5px solid var(--color-ink); border-radius: var(--radius-sm); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-3); background: var(--color-surface); }
  .faq-item summary { font-family: var(--font-display); font-weight: 700; cursor: pointer; }
  .faq-item p { margin-top: var(--space-2); color: var(--color-text-muted); line-height: 1.6; }

  .art-side { position: sticky; top: 80px; display: flex; flex-direction: column; gap: var(--space-4); }
  .side-box { border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); padding: var(--space-4); background: var(--color-surface); box-shadow: var(--shadow-hard-sm); }
  .side-box h3 { font-size: 1rem; margin-bottom: var(--space-3); }
  .side-links { list-style: none; padding: 0; margin: 0; }
  .side-links li { margin-bottom: var(--space-2); }
  .side-links a { font-size: 0.9rem; color: var(--color-text); text-decoration: none; font-weight: 500; }
  .side-links a:hover { color: var(--color-primary); }
  .side-cta { background: var(--color-accent); }
  .side-cta-label { font-family: var(--font-display); font-weight: 700; margin-bottom: var(--space-3); }
  .btn-block { width: 100%; }
  @media (max-width: 900px) {
    .art-grid { grid-template-columns: 1fr; }
    .art-side { position: static; }
    .map-meta { flex-direction: column; align-items: stretch; text-align: center; }
  }

  /* CALL CTA */
  .call-cta { margin-bottom: var(--space-7); }
  .call-cta-inner { background: var(--color-primary); border: 2.5px solid var(--color-ink); border-radius: var(--radius-lg); padding: var(--space-6); text-align: center; box-shadow: var(--shadow-hard); }
  .call-cta-tag { display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-yellow); margin-bottom: var(--space-3); }
  .call-cta-phone { display: inline-flex; align-items: center; gap: var(--space-3); background: var(--color-yellow); border: 2.5px solid var(--color-ink); border-radius: var(--radius-md); padding: var(--space-4) var(--space-6); font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 4vw, 2.4rem); color: var(--color-ink); text-decoration: none; box-shadow: var(--shadow-hard-sm); transition: transform 0.12s ease, box-shadow 0.12s ease; margin-bottom: var(--space-4); }
  .call-cta-phone:hover { transform: translate(-3px,-3px); box-shadow: var(--shadow-hard); color: var(--color-ink); }
  .call-cta-phone i { font-size: 1.3rem; }
  .call-cta-sub { color: #fff; opacity: 0.9; font-size: 0.95rem; margin-bottom: var(--space-3); max-width: 480px; margin-left: auto; margin-right: auto; }
  .call-cta-tty { font-size: 0.88rem; color: rgba(255,255,255,0.75); margin: 0; }
  .call-cta-tty a { color: var(--color-yellow); text-decoration: underline; }


  .call-cta-alt { display: inline-flex; align-items: center; gap: 8px; margin-top: var(--space-4); padding: 10px 18px; background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.3); border-radius: var(--radius-pill); font-family: var(--font-display); font-size: 0.85rem; font-weight: 600; color: #fff; text-decoration: none; transition: background 0.15s ease, border-color 0.15s ease; }
  .call-cta-alt:hover { background: rgba(255,255,255,0.18); border-color: var(--color-yellow); color: var(--color-yellow); }
  /* phone-link inline (en parrafos) */
  .phone-link { font-weight: 600; color: var(--color-primary); text-decoration: underline; text-decoration-thickness: 2px; }
  .phone-link:hover { color: var(--color-primary-hover); }
</style>
