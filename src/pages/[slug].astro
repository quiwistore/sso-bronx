---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { allPages, getPage, site } from '../data/datos.js';

export function getStaticPaths() {
  return allPages.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const page = getPage(slug);
const sections = page.sections || [];
const siloLabel = { services: 'Services', office: 'Office info', learn: 'Learn' }[page.silo];

// Helpers
function iconForStep(q) {
  const t = (q || '').toLowerCase();
  if (/online|website|web|laptop|computer/.test(t)) return 'fa-laptop';
  if (/phone|call|800|by phone/.test(t)) return 'fa-phone';
  if (/in person|visit|office|walk[\s-]?in|appointment/.test(t)) return 'fa-building-columns';
  if (/form|complete|fill|application|ss-?5/.test(t)) return 'fa-file-lines';
  if (/document|original|gather|bring|certified/.test(t)) return 'fa-folder-open';
  if (/interview|representative|meeting/.test(t)) return 'fa-user-tie';
  if (/mail|receive|arrives|by mail/.test(t)) return 'fa-envelope';
  if (/wait|process|time|days|weeks/.test(t)) return 'fa-hourglass-half';
  if (/decision|review|approved|denied/.test(t)) return 'fa-clipboard-check';
  return 'fa-circle-dot';
}

// Office number (para office tag, si aplica)
const officeNumbers = {
  'social-security-office-south-bronx': '01',
  'social-security-office-east-bronx': '02',
  'social-security-office-hunts-point-bronx': '03',
  'social-security-office-laconia-avenue-bronx': '04',
  'social-security-office-north-bronx': '05',
  'social-security-office-west-farms-bronx': '06',
};
const officeNum = officeNumbers[slug];

// Article number total (para eyebrow)
const articleIdx = allPages.findIndex(p => p.slug === slug);

const extraFaqs = sections.find(s => s.type === 'faq_extra')?.items || [];
const filteredSections = sections.filter(s => s.type !== 'faq_extra');
---
<Base title={page.title} description={page.meta}>
  <article class="article">
    <div class="container">
      <Breadcrumbs items={[
        { href: '/', label: 'Home' },
        { label: page.h1 }
      ]} />

      <header class="article-head">
        <div class="article-eyebrow">
          <span class="silo-label">{siloLabel}</span>
          <span class="eyebrow-issue">No. {String(articleIdx + 1).padStart(2,'0')} · 2026</span>
        </div>
        {officeNum && (
          <div class="office-tag-large">
            <span class="num">Office №{officeNum}</span>
            <span class="dot">·</span>
            <span>Bronx, NY</span>
          </div>
        )}
        <h1>{page.h1}</h1>
        {page.intro && <p class="article-lead" set:html={page.intro}></p>}
      </header>

      <div class="article-grid">
        <div class="article-main">
          {filteredSections.map(sec => (
            <>
              {sec.type === 'quick_answer' && (
                <div class="quick-answer">
                  <span class="qa-tag">{sec.heading}</span>
                  <p set:html={sec.body}></p>
                </div>
              )}

              {sec.type === 'quick_answer' && page.embed_src && (
                <div class="office-map">
                  <iframe
                    src={page.embed_src}
                    width="100%"
                    height="380"
                    style="border:0;"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`Map of ${page.h1}`}
                  ></iframe>
                  <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(page.h1)}`} class="map-link" target="_blank" rel="noopener">Open in Google Maps →</a>
                </div>
              )}

              {sec.type === 'section' && (
                <section class="rich">
                  <h2>{sec.heading}</h2>
                  {sec.body.map(par => <p set:html={par}></p>)}
                </section>
              )}

              {sec.type === 'checklist' && (
                <section class="rich">
                  <h2>{sec.heading}</h2>
                  <ul class="check-list">{sec.items.map(it => <li set:html={it}></li>)}</ul>
                </section>
              )}

              {sec.type === 'troubleshoot' && (
                <section class="rich">
                  <h2>{sec.heading}</h2>
                  <div class="stepper">
                    {sec.items.map((it, idx) => (
                      <div class="step-card">
                        <div class="step-head">
                          <span class="step-num">{String(idx + 1).padStart(2, '0')}</span>
                          <i class={`fa-solid ${iconForStep(it.q)} step-icon`} aria-hidden="true"></i>
                        </div>
                        <h4>{it.q}</h4>
                        <p set:html={it.a}></p>
                      </div>
                    ))}
                  </div>
                </section>
              )}
            </>
          ))}

          <section class="cta-box">
            <h2>Need to visit a Bronx SSA office?</h2>
            <p>Get the address, hours, and how to book an appointment.</p>
            <div class="cta-actions">
              <a href="/social-security-office-bronx/" class="btn btn-primary">All Bronx offices</a>
              <a href="https://www.ssa.gov/agency/contact/" class="btn btn-ghost">Book on SSA.gov</a>
            </div>
          </section>

          {extraFaqs.length > 0 && (
            <section class="faq">
              <h2>Frequently asked questions</h2>
              {extraFaqs.map(f => (
                <details class="faq-item">
                  <summary>{f.q}</summary>
                  <div set:html={f.a}></div>
                </details>
              ))}
            </section>
          )}
        </div>

        <aside class="article-side">
          <div class="side-box">
            <span class="side-tag">Office info</span>
            <ul class="side-links">
              <li><a href="/social-security-office-bronx/">All Bronx SSA offices</a></li>
              <li><a href="/social-security-office-hours-bronx/">Office hours</a></li>
              <li><a href="/social-security-office-appointment-bronx/">Book an appointment</a></li>
              <li><a href="/ssa-required-documents-bronx/">What to bring</a></li>
              <li><a href="/ssa-spanish-services-bronx/">Spanish services</a></li>
            </ul>
          </div>
          <div class="side-box side-cta">
            <span class="side-tag">Need to apply?</span>
            <a href="/apply-for-social-security-card-bronx/" class="btn btn-primary btn-block">Apply for SSN card</a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
  .article { padding: var(--space-6) 0 var(--space-7); }

  .article-head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-w) solid var(--color-ink);
    max-width: 820px;
  }
  .article-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .silo-label {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
    padding: 4px 10px;
    border: var(--border-w) solid var(--color-primary);
    border-radius: var(--radius-pill);
  }
  .office-tag-large {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }
  .office-tag-large .num {
    color: var(--color-primary);
    font-weight: 700;
  }
  .article-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 7vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-4);
    color: var(--color-ink);
  }
  .article-lead {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .article-main { min-width: 0; }

  /* QUICK ANSWER */
  .quick-answer {
    background: var(--color-highlight);
    border: var(--border-w) solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
    box-shadow: var(--shadow-hard-sm);
  }
  .qa-tag {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }
  .quick-answer p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    font-weight: 500;
  }
  .quick-answer a { color: var(--color-ink); text-decoration-thickness: 2px; }

  /* MAP */
  .office-map {
    margin-bottom: var(--space-6);
    border: var(--border-w) solid var(--color-ink);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-hard-sm);
    background: var(--color-bg-alt);
  }
  .office-map iframe {
    display: block;
    width: 100%;
    height: 320px;
    border: 0;
  }
  .map-link {
    display: block;
    text-align: center;
    padding: var(--space-3);
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    transition: background 0.15s;
    letter-spacing: 0.02em;
  }
  .map-link:hover { background: var(--color-primary); color: #fff; }

  /* RICH (sections, paragraphs) */
  .rich { margin-bottom: var(--space-6); }
  .rich h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1.5px solid var(--color-ink);
    letter-spacing: -0.015em;
  }
  .rich p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }
  .rich p:last-child { margin-bottom: 0; }
  .rich a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    font-weight: 500;
  }
  .rich strong { color: var(--color-ink); font-weight: 700; }

  /* CHECK LIST */
  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .check-list li {
    position: relative;
    padding: var(--space-3) var(--space-4) var(--space-3) 42px;
    background: var(--color-surface);
    border: var(--border-w) solid var(--color-ink);
    border-radius: var(--radius-sm);
    line-height: 1.55;
    box-shadow: var(--shadow-hard-sm);
    font-size: 0.95rem;
  }
  .check-list li::before {
    content: '';
    position: absolute;
    left: 16px; top: 50%;
    width: 8px; height: 14px;
    border: solid var(--color-primary);
    border-width: 0 3px 3px 0;
    transform: translateY(-65%) rotate(45deg);
  }
  .check-list li a {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .check-list strong { color: var(--color-ink); font-weight: 700; }

  /* STEPPER */
  .stepper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .step-card {
    background: var(--color-surface);
    border: var(--border-w) solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-hard-sm);
  }
  .step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-soft);
  }
  .step-num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }
  .step-icon {
    font-size: 1.6rem;
    color: var(--color-primary);
    opacity: 0.4;
  }
  .step-card h4 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }
  .step-card p {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }
  .step-card a { color: var(--color-primary); }

  /* CTA box */
  .cta-box {
    background: var(--color-primary);
    color: #fff;
    border: var(--border-w) solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-hard);
    margin: var(--space-6) 0;
    text-align: center;
  }
  .cta-box h2 {
    color: #fff;
    margin-bottom: var(--space-3);
    border: none;
    font-size: 1.4rem;
    padding: 0;
  }
  .cta-box p {
    color: rgba(255,255,255,0.9);
    margin-bottom: var(--space-4);
  }
  .cta-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-box .btn-primary {
    background: var(--color-highlight);
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .cta-box .btn-primary:hover { color: var(--color-ink); }
  .cta-box .btn-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255,255,255,0.5);
    box-shadow: none;
  }
  .cta-box .btn-ghost:hover { background: rgba(255,255,255,0.1); color: #fff; }

  /* FAQ */
  .faq { margin-top: var(--space-6); }
  .faq h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }
  .faq-item {
    border: var(--border-w) solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    margin-bottom: var(--space-3);
    overflow: hidden;
  }
  .faq-item summary {
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 40px;
    line-height: 1.4;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-primary);
    font-weight: 400;
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item > div {
    padding: 0 var(--space-4) var(--space-4);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text);
  }
  .faq-item a { color: var(--color-primary); }
  .faq-item strong { color: var(--color-ink); font-weight: 700; }

  /* SIDEBAR */
  .article-side { display: flex; flex-direction: column; gap: var(--space-4); }
  .side-box {
    background: var(--color-surface);
    border: var(--border-w) solid var(--color-ink);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .side-tag {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-soft);
  }
  .side-links { list-style: none; padding: 0; margin: 0; }
  .side-links li { margin: 0; border-bottom: 1px solid var(--color-border-soft); }
  .side-links li:last-child { border-bottom: none; }
  .side-links a {
    display: block;
    padding: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    line-height: 1.3;
  }
  .side-links a:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .side-cta { background: var(--color-bg-alt); }

  /* TABLET */
  @media (min-width: 760px) {
    .article { padding: var(--space-7) 0 var(--space-8); }
    .article-head h1 { font-size: clamp(2.2rem, 4vw, 3rem); }
    .article-lead { font-size: 1.18rem; }
    .stepper { grid-template-columns: repeat(2, 1fr); }
    .office-map iframe { height: 380px; }
  }

  /* DESKTOP */
  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: minmax(0, 720px) 300px;
      gap: var(--space-8);
      align-items: start;
      justify-content: start;
    }
    .article-side {
      position: sticky;
      top: 90px;
    }
    .rich h2 { font-size: 1.6rem; }
  }
</style>
